PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Set these as Supabase Edge Function secrets, not in the frontend.
# ACCESS_PASSWORD_HASH is the lowercase SHA-256 hex digest of the password.
ACCESS_PASSWORD_HASH=sha256-password-digest
JWT_SECRET=your-project-jwt-secret
GENIUS_ACCESS_TOKEN=your-genius-access-token
GENIUS_BASE_API_URL=https://genius-song-lyrics1.p.rapidapi.com
GENIUS_BASE_API_HOST=genius-song-lyrics1.p.rapidapi.com
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
