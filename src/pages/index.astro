---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<header class="fixed inset-x-0 top-0 z-20 flex h-14 items-center justify-between bg-[#0d0f10]/90 px-6 backdrop-blur">
		<div class="text-[13px] font-extrabold tracking-[0.08em]">kotoba</div>
	</header>
	<main class="flex min-h-screen items-center justify-center px-6 pb-12 pt-14">
		<section class="w-full max-w-sm" aria-labelledby="access-title">
			<div class="mb-8 flex items-center gap-3">
				<div class="flex h-9 w-9 items-center justify-center rounded-lg bg-[#181b1c] text-[#d7ff72]" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" class="h-4 w-4" stroke="currentColor" stroke-width="1.8"><rect x="5" y="10" width="14" height="10" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path></svg></div>
				<div><h1 id="access-title" class="text-sm font-semibold">Access required</h1><p class="mt-1 text-xs text-[#8a908d]">Enter your credentials to continue.</p></div>
			</div>
			<form id="unlock-form" class="space-y-5">
				<label class="mb-2 block text-xs text-[#8a908d]" for="credential">Credential</label>
				<input id="credential" name="credential" type="password" autocomplete="current-password" required placeholder="••••••••••••" class="w-full border-0 border-b border-[#2a2e2f] bg-transparent px-0 py-3 text-base text-[#f3f4f1] outline-none placeholder:text-[#505653] focus:border-[#555d59] focus:ring-0" />
				<button id="unlock-button" type="submit" class="inline-flex min-w-[92px] items-center justify-center gap-2 rounded-lg bg-[#181b1c] px-4 py-2.5 text-sm font-medium text-[#d9ddda] transition hover:bg-[#202425] disabled:cursor-default disabled:opacity-70"><span id="button-content">Unlock <span class="text-[#8a908d]">→</span></span></button>
			</form>
			<p id="error" class="mt-4 hidden text-xs text-[#d58c8c]" role="alert">Access denied.</p>
		</section>
	</main>
</Layout>

<script>
	import { saveAccessToken, supabaseAnonKey, supabaseUrl } from '../lib/supabase';
	const form = document.querySelector<HTMLFormElement>('#unlock-form');
	const input = document.querySelector<HTMLInputElement>('#credential');
	const button = document.querySelector<HTMLButtonElement>('#unlock-button');
	const content = document.querySelector<HTMLElement>('#button-content');
	const error = document.querySelector<HTMLElement>('#error');

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!input || !button || !content || !error || !input.value) return;
		button.disabled = true;
		error.classList.add('hidden');
		content.textContent = 'Unlocking…';
		try {
			if (!supabaseUrl || !supabaseAnonKey) throw new Error('Supabase public configuration is missing.');
			const response = await fetch(`${supabaseUrl}/functions/v1/authorize`, { method: 'POST', headers: { 'Content-Type': 'application/json', apikey: supabaseAnonKey }, body: JSON.stringify({ credential: input.value }) });
			if (!response.ok) throw new Error('Unauthorized');
			const { access_token: accessToken } = await response.json();
			if (!accessToken) throw new Error('Authorization token missing');
			saveAccessToken(accessToken);
			window.location.assign('/songs');
		} catch {
			error.classList.remove('hidden');
			button.disabled = false;
			content.innerHTML = 'Unlock <span class="text-[#8a908d]">→</span>';
		}
	});
</script>
