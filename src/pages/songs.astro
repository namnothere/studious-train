---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Kotoba">
	<header class="fixed inset-x-0 top-0 z-20 flex h-14 items-center bg-[#0d0f10]/90 px-6 backdrop-blur"><div class="text-[13px] font-extrabold tracking-[0.08em]">kotoba</div></header>
	<main class="mx-auto min-h-screen max-w-4xl px-6 pb-24 pt-20">
		<section id="search-view" aria-labelledby="search-title">
			<h1 id="search-title" class="sr-only">Search songs</h1>
			<form id="search-form" class="mb-8"><label class="sr-only" for="search-input">Search songs or artists</label><input id="search-input" type="search" autocomplete="off" placeholder="Search songs or artists" class="w-full border-0 border-b border-[#242829] bg-transparent px-0 py-4 text-[22px] tracking-[-0.02em] text-[#f3f4f1] outline-none placeholder:text-[#5f6663] focus:border-[#4b5350] focus:ring-0" /></form>
			<p id="search-status" class="text-sm text-[#8a908d]" aria-live="polite">Search for a song or artist.</p><div id="results" class="space-y-0" aria-live="polite"></div>
			<section id="recent-section" class="mt-16" aria-labelledby="recent-title">
				<div class="mb-5"><p class="mb-2 text-[10px] font-bold uppercase tracking-[0.18em] text-[#d7ff72]">Your listening</p><h2 id="recent-title" class="m-0 text-2xl font-bold tracking-[-0.04em]">Recently played</h2></div>
				<div id="recent-songs"></div>
			</section>
		</section>
	</main>
</Layout>

<style>
	:global(#recent-songs) { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
	:global(#recent-songs .recent-song) { min-width:0; text-align:left; cursor:pointer; transition:transform 160ms ease, border-color 160ms ease, background 160ms ease; }
	:global(#recent-songs .recent-song:hover) { transform:translateY(-2px); border-color:#3c4741; background:linear-gradient(145deg,#202722,#121615); }
	:global(#recent-songs .recent-song:focus-visible) { outline:2px solid #d7ff72; outline-offset:3px; }
	:global(#recent-songs .recent-art) { display:block; width:100%; height:auto; object-fit:cover; }
	:global(#recent-songs .recent-song) { display:flex; align-items:center; gap:12px; min-height:80px; padding:12px; border:1px solid #242829; border-radius:12px; background:linear-gradient(145deg,#1a1e1c,#101212); }
	:global(#recent-songs .recent-art) { width:56px; height:56px; border-radius:8px; }
	@media (max-width: 560px) { :global(#recent-songs) { grid-template-columns:1fr; } }
</style>

<script>
  import { clearAccessToken, hasAccessToken, supabaseAnonKey, supabaseUrl } from '../lib/supabase';
	const base = import.meta.env.BASE_URL.replace(/\/$/, '');
	type SearchSong = { geniusId: number; title: string; artist: string; artworkUrl: string | null; geniusUrl: string };
	const form = document.querySelector<HTMLFormElement>('#search-form'), input = document.querySelector<HTMLInputElement>('#search-input'), status = document.querySelector<HTMLElement>('#search-status'), results = document.querySelector<HTMLElement>('#results');
	const recent = document.querySelector<HTMLElement>('#recent-songs'), recentSection = document.querySelector<HTMLElement>('#recent-section');

	async function genius(body: object) {
		const token = localStorage.getItem('kotoba.access_token');
		if (!supabaseUrl || !supabaseAnonKey || !token) throw new Error('Not authorized');
		const response = await fetch(`${supabaseUrl}/functions/v1/genius`, { method: 'POST', headers: { Authorization: `Bearer ${token}`, apikey: supabaseAnonKey, 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
		if (response.status === 401) { clearAccessToken(); window.location.assign(`${base}/`); throw new Error('Not authorized'); }
		if (!response.ok) throw new Error('Genius request failed');
		return response.json();
	}

	function songUrl(song: SearchSong) { const slug = song.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''); sessionStorage.setItem(`kotoba.song.${slug}`, JSON.stringify(song)); return `${base}/song?slug=${encodeURIComponent(slug)}`; }

	function renderSongs(songs: SearchSong[]) {
		if (!results) return;
		results.replaceChildren(...songs.map((song) => {
			const row = document.createElement('button'); row.type = 'button'; row.className = 'song-row group flex w-full items-center gap-3 border-0 border-b border-white/[0.03] bg-transparent py-3 text-left transition hover:bg-white/[0.025]';
			row.innerHTML = '<img class="song-art h-11 w-11 shrink-0 rounded-md object-cover" alt=""><div class="min-w-0 flex-1"><div class="truncate text-sm font-semibold"></div><div class="mt-0.5 truncate text-xs text-[#8a908d]"></div></div>';
			const labels = row.querySelectorAll('div div'); labels[0].textContent = song.title; labels[1].textContent = song.artist;
			if (song.artworkUrl) row.querySelector<HTMLImageElement>('.song-art')!.src = song.artworkUrl;
			row.addEventListener('click', () => window.location.assign(songUrl(song))); return row;
		}));
	}

	function renderRecent(recentSongs: SearchSong[]) {
		if (!recent) return;
		recent.replaceChildren(...recentSongs.map((song, ) => {
			const item = document.createElement('button'); item.type = 'button'; item.className = 'recent-song group w-full text-left transition hover:bg-white/[0.04] p-2';
			item.innerHTML = `<img class="recent-art rounded-lg bg-gradient-to-br from-[#65705e] via-[#303b35] to-[#151918] object-cover" alt=""><div class="min-w-0"><div class="truncate text-sm font-semibold">${song.title}</div><div class="mt-1 truncate text-xs text-[#8a908d]">${song.artist}</div></div>`;
			if (song.artworkUrl) item.querySelector<HTMLImageElement>('.recent-art')!.src = song.artworkUrl;
			item.addEventListener('click', () => window.location.assign(songUrl(song))); return item;
		}));
		if (recentSection) recentSection.hidden = !recentSongs.length;
	}
	genius({ action: 'recent' }).then(({ songs }) => renderRecent(songs)).catch(() => { if (recentSection) recentSection.hidden = true; });

	form?.addEventListener('submit', async (event) => {
		event.preventDefault(); const query = input?.value.trim(); if (!query || !status) return; status.textContent = 'Searching…'; results?.replaceChildren();
		try { const { songs } = await genius({ action: 'search', query }); renderSongs(songs); status.textContent = songs.length ? '' : 'No usable songs found.'; } catch { status.textContent = 'Search failed. Try again.'; }
	});
	if (!hasAccessToken()) window.location.assign(`${base}/`);
</script>
